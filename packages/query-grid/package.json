{
  "name": "@kikstart/query-grid",
  "version": "0.4.0",
  "description": "The React-free core of query-grid: the query contract, URL codec, validation, offers, feeds and data sources for a filter and data grid that only offers what an index answers.",
  "keywords": [
    "data-grid",
    "postgres",
    "keyset-pagination",
    "filter",
    "query-state"
  ],
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kikstartai/query-grid.git",
    "directory": "packages/query-grid"
  },
  "bugs": "https://github.com/Kikstartai/query-grid/issues",
  "homepage": "https://query-grid.vercel.app",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "default": "./dist/http.js"
    },
    "./memory": {
      "types": "./dist/memory.d.ts",
      "default": "./dist/memory.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "lint": "eslint src scripts",
    "prepack": "bun scripts/build.ts && bun scripts/copy-docs.ts",
    "test": "bun test src",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22",
    "eslint": "^9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.46.0"
  }
}
