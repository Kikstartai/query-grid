{
  "name": "@kikstart/query-grid-postgres",
  "version": "0.3.0",
  "description": "The Postgres server half of @kikstart/query-grid: declared query shapes, the SQL builder, keyset paging, index and counter DDL, and one fetch-standard request handler.",
  "keywords": [
    "postgres",
    "keyset-pagination",
    "data-grid",
    "filter",
    "query-grid"
  ],
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kikstartai/query-grid.git",
    "directory": "packages/query-grid-postgres"
  },
  "bugs": "https://github.com/Kikstartai/query-grid/issues",
  "homepage": "https://query-grid.vercel.app",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "lint": "eslint src scripts",
    "prepack": "bun scripts/build.ts && bun scripts/copy-docs.ts",
    "test": "bun test src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@kikstart/query-grid": "0.3.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22",
    "eslint": "^9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.46.0"
  }
}
